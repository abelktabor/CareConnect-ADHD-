<?xml version="1.0" encoding="utf-8"?>
<!--
  CareConnect stores medication and appointment state in SharedPreferences.
  Even though this build ships only fictional sample data, the product's
  domain is health information, so the app opts out of Android cloud backup
  and device-to-device transfer rather than letting that state leave the
  device implicitly (NIST SSDF PW.9.1 secure defaults, PS.1.1 protect data).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
